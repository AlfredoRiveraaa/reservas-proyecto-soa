# ==========================================================
# ReservaSOA - Variables de entorno de ejemplo
# Copie este archivo como ".env" y ajuste los valores locales.
# NUNCA publique el archivo ".env" real en el repositorio.
# ==========================================================

# Seguridad y autenticación
JWT_SECRET_KEY=cambia-esta-clave-secreta-en-tu-entorno-local
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Llave interna para comunicación servicio-a-servicio (X-Service-Key)
INTERNAL_SERVICE_KEY=cambia-esta-llave-interna-soa

# Puertos de los servicios SOA
GATEWAY_PORT=8000
USERS_SERVICE_PORT=8001
SPACES_SERVICE_PORT=8002
RESERVATIONS_SERVICE_PORT=8003
NOTIFICATIONS_SERVICE_PORT=8004

# URLs internas de descubrimiento de servicios
USERS_SERVICE_URL=http://127.0.0.1:8001
SPACES_SERVICE_URL=http://127.0.0.1:8002
RESERVATIONS_SERVICE_URL=http://127.0.0.1:8003
NOTIFICATIONS_SERVICE_URL=http://127.0.0.1:8004

# Directorio de persistencia SQLite independiente por servicio
DATA_DIR=data

# Tiempo máximo de espera (segundos) en llamadas HTTP entre servicios
HTTP_TIMEOUT_SECONDS=5.0
